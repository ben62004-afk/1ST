# --- Derived / recomputable layers (never committed) ---
# Processed layer is always rebuilt from raw/.
data/processed/*
!data/processed/.gitkeep
# DuckDB database is built by the load step.
data/*.duckdb
data/*.duckdb.wal
# Coverage report is generated by the pipeline.
data/coverage_report.md

# --- Raw layer ---
# Real raw data is produced by `pipeline fetch`; demo data by `pipeline demo`.
# Neither is committed (demo would masquerade as real ground truth).
data/raw/*
!data/raw/.gitkeep

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
